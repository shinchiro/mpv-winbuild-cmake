From 1379dde89edb2780da5651c6890e8f6def413ef8 Mon Sep 17 00:00:00 2001
From: shinchiro <shinchiro@users.noreply.github.com>
Date: Sat, 6 Apr 2024 11:38:08 +0800
Subject: [PATCH 2/2] Do not use dirent.h

Because this causes some quirks on some partitions on Windows.
Relevant issue: https://github.com/mpv-player/mpv/issues/10679
---
 meson.build | 1 -
 1 file changed, 1 deletion(-)

diff --git a/meson.build b/meson.build
index bbfc5237..768e6f67 100644
--- a/meson.build
+++ b/meson.build
@@ -126,7 +126,6 @@ python3 = import('python').find_installation()
 pytest = find_program('pytest', required: false)
 
 check_headers = [
-  ['dirent.h'],
   ['dlfcn.h'],
   ['fcntl.h'],
   ['inttypes.h'],
-- 
2.56.0

